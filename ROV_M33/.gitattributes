# Preserve portable source/configuration line endings across Windows checkouts.
* text=auto
*.c text eol=lf
*.h text eol=lf
*.s text eol=lf
*.S text eol=lf
*.ld text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.project text eol=lf
*.cproject text eol=lf
*.xml text eol=lf

*.pyd binary
*.png binary
*.jpg binary
*.pdf binary
